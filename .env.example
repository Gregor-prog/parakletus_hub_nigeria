# Copy to .env.local for development. In production these live in Vercel's
# environment variables. Never commit real values.

# ── Admin console (admin.parakletushub.com) ─────────────────────────
# Generate the hash and secret with:  pnpm admin:credentials
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ── Product backends ────────────────────────────────────────────────
# <PREFIX>_API_URL      base URL, including any path prefix (https required in production)
# <PREFIX>_API_TOKEN    the same value as that backend's ADMIN_CONSOLE_TOKEN; sent as the
#                       x-console-token header to its read-only /console/* API.
#                       Make one per backend with:  openssl rand -base64 48
# <PREFIX>_HEALTH_PATH  optional override of the default health path

# ParaLearn core ("K12") on Azure. Health: /health
PARALEARN_API_URL=https://paralearn-backend-01-byhyg6hydqe8f7c3.switzerlandnorth-01.azurewebsites.net
PARALEARN_API_TOKEN=

# ParaLearn CBT on Azure (App Service "ParalearnCBT", see its Default domain). Health: /health
PARALEARN_CBT_API_URL=
PARALEARN_CBT_API_TOKEN=

# SabiNote on Azure. The URL includes /api/v1; health is then /health.
SABINOTE_API_URL=https://sabinote-backend-hmdmbjdzfcddgghf.switzerlandnorth-01.azurewebsites.net/api/v1
SABINOTE_API_TOKEN=

# IJSDS on Azure (App Service "ijsds-database"). Health: /health
IJSDS_API_URL=https://ijsds-database-ftb5hpfrfecegtbz.switzerlandnorth-01.azurewebsites.net
IJSDS_API_TOKEN=

# Parakletus Publishing
PUBLISHING_API_URL=
PUBLISHING_API_TOKEN=

# GSI Buildathon
GSI_API_URL=
GSI_API_TOKEN=
